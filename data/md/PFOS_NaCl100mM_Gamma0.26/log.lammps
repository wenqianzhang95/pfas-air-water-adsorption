# ------------------- Output -------------------
 compute T_water water temp
 compute T_PFOS PFOS temp
 compute V all voronoi/atom
 compute msd water msd com yes

 compute RDF_SNa all rdf 200 6 10
 compute RDF_ONa all rdf 200 7 10
 compute RDF_SCl all rdf 200 6 11
 compute RDF_OCl all rdf 200 7 11

 compute NaDen counterion chunk/atom bin/1d z lower 1 units box
 compute ClDen coion chunk/atom bin/1d z lower 1 units box
 compute WaterDen water chunk/atom bin/1d z lower 1 units box
 compute PFASDen PFOS chunk/atom bin/1d z lower 1 units box
 compute PFAS_ODen PFOS_O chunk/atom bin/1d z lower 1 units box

 compute CHARGE all property/atom q
 compute CHUNK_XBIN_ALL all chunk/atom bin/1d z lower 1 units box
 compute charge_dist all chunk/atom bin/2d x lower 1 y lower 1 units box

 compute PFAS PFOS group/group PFOS
 compute Water water group/group PFOS
 compute Na counterion group/group PFOS
 compute Cl coion group/group PFOS

 variable twopoint equal c_msd[4]/6/(step*dt+1.0e-6)
 fix 9 all vector 10 c_msd[4]                            #store the MSD in f_9
 variable fitslope equal slope(f_9)/6/(10*dt)
 variable Vtot equal sum(c_V)

 # Set up pressure tensor components
 # c_thermo_press[1] is the XX component of the pressure tensor
 variable xPress equal c_thermo_press[1]
 variable yPress equal c_thermo_press[2]
 variable zPress equal c_thermo_press[3]

 # Compute surface tension
 variable A_in_m equal 1e-10 # Angstrom in meter
 variable atm_in_Pa equal 101325 # note: 1 Pa = 1 N/m^2
 variable N_in_mN equal 1e3 # Newton in milliNewton
 variable convFac equal ${A_in_m}*${atm_in_Pa}*${N_in_mN}
 variable convFac equal 1e-10*${atm_in_Pa}*${N_in_mN}
 variable convFac equal 1e-10*101325*${N_in_mN}
 variable convFac equal 1e-10*101325*1000
 # lz is the box length in the z-dimention
 variable st equal 0.5*lz*(v_zPress-0.5*(v_xPress+v_yPress))*${convFac} # in mN/m
 variable st equal 0.5*lz*(v_zPress-0.5*(v_xPress+v_yPress))*0.0101325 
 fix st all ave/time 50 1 50 v_st file "out.surfTension.txt"

 thermo 10000
 thermo_style	custom step temp etotal press v_twopoint v_fitslope
 thermo_modify flush yes
 dump img all xyz 10000  waterPFOS.xyz
 dump myDump all atom 10000 trajectory.data
 dump_modify myDump every 50000
 dump_modify img element C C C F F S O P N Na Cl

# ----------------- Run Section -----------------
 velocity     water create 300 372748 rot yes dist gaussian
 velocity     PFOS create 300 372748 rot yes dist gaussian
 velocity     counterion create 300 372748 rot yes dist gaussian
 velocity     coion create 300 372748 rot yes dist gaussian

 fix fShakeSPCE water shake 0.0001 10 0 b 1 a 1
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
       0 = # of frozen angles
  find clusters CPU = 0.015 seconds
 fix  fxnvt1 all nvt temp 300.0 300.0 100.0
 fix  RDF1 all ave/time 100 1000 100000 c_RDF_SNa[*] file rdf_SNa.rdf mode vector
 fix  RDF2 all ave/time 100 1000 100000 c_RDF_ONa[*] file rdf_ONa.rdf mode vector
 fix  RDF3 all ave/time 100 1000 100000 c_RDF_SCl[*] file rdf_SCl.rdf mode vector
 fix  RDF4 all ave/time 100 1000 100000 c_RDF_OCl[*] file rdf_OCl.rdf mode vector

 fix  PFASPFAS all ave/time 100 1000 100000 c_PFAS c_PFAS[1] c_PFAS[2] c_PFAS[3] file PFASPFAS.txt
 fix  waterPFAS all ave/time 100 1000 100000 c_Water c_Water[1] c_Water[2] c_Water[3] file waterPFAS.txt
 fix  ClPFAS all ave/time 100 1000 100000 c_Cl c_Cl[1] c_Cl[2] c_Cl[3] file ClPFAS.txt
 fix  NaPFAS all ave/time 100 1000 100000 c_Na c_Na[1] c_Na[2] c_Na[3] file NaPFAS.txt

 fix  DP1 counterion ave/chunk 100 1000 100000 NaDen density/number file Na.profile
 fix  DP2 coion ave/chunk 100 1000 100000 ClDen density/number file Cl.profile
 fix  DP3 water ave/chunk 100 1000 100000 WaterDen density/number file water.profile
 fix  DP4 PFOS ave/chunk 100 1000 100000 PFASDen density/number file PFAS.profile
 fix  DP5 PFOS_O ave/chunk 100 1000 100000 PFAS_ODen density/number file O.profile

 fix CHARGE_DENSITY_FIX all ave/chunk 100 1000 100000 CHUNK_XBIN_ALL c_CHARGE file out.charge_density
 fix charge_dis all ave/chunk 100 1000 100000 charge_dist c_CHARGE file charge_xy.dat

 #restart 100000 restart_file

 #timestep 0.5     #dt=5e-7 ns
 #run   20000

timestep 1
 run   2000000      #t=0.1 ns
